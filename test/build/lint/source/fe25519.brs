sub fe_sub(o as object, a as object, b as object)
    t0 = a[0] + 15586 - b[0]
    t1 = a[1] + 16382 - b[1]
    t2 = a[2] + 16382 - b[2]
    t3 = a[3] + 16382 - b[3]
    t4 = a[4] + 16382 - b[4]
    t5 = a[5] + 16382 - b[5]
    t6 = a[6] + 16382 - b[6]
    t7 = a[7] + 16382 - b[7]
    t8 = a[8] + 16382 - b[8]
